                <div
                    class="col-span-2 max-[1500px]:col-span-4 grid grid-cols-2 gap-2 items-start border-t border-t-black pt-1 text-nowrap"
                >
                    <div
                        class="col-span-2 flex flex-row justify-between w-full"
                    >
                        <p class="w-fit">Start</p>
                        <p class="w-fit">a</p>
                        <p class="w-fit">Conversation</p>
                    </div>
                </div>
            </div>
        </nav>

        <script>
            import { gsap } from "gsap";

            const links =
                document.querySelectorAll<HTMLElement>("[data-nav-link]");

            links.forEach((link) => {
                const hl = link.querySelector<HTMLElement>("[data-nav-hl]");
                const text = link.querySelector<HTMLElement>("span.relative");
                if (!hl) return;

                gsap.set(hl, { scaleY: 0, transformOrigin: "center top" });

                link.addEventListener("mouseenter", () => {
                    text?.classList.add("font-bold");
                    gsap.to(hl, {
                        scaleY: 1,
                        transformOrigin: "center top",
                        duration: 0.25,
                        ease: "power3.out",
                        overwrite: true,
                    });
                });

                link.addEventListener("mouseleave", () => {
                    text?.classList.remove("font-bold");
                    gsap.to(hl, {
                        scaleY: 0,
                        transformOrigin: "center bottom",
                        duration: 0.25,
                        delay: 0.15,
                        ease: "power3.out",
                        overwrite: true,
                    });
                });
            });
        </script>
    </body>
    <slot />
