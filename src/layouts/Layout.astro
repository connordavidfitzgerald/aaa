---
import "../styles/global.css";
import Navbar from "../assets/components/Navbar.astro";

interface Props {
    title?: string;
}

const { title = "Applied Archive Atelier" } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link
            rel="preload"
            href="/fonts/ABCFavorit-Book.ttf"
            as="font"
            type="font/ttf"
            crossorigin
        />
        <link
            rel="preload"
            href="/fonts/ABCFavorit-Medium.ttf"
            as="font"
            type="font/ttf"
            crossorigin
        />
        <link
            rel="preload"
            href="/fonts/ABCFavorit-Bold.ttf"
            as="font"
            type="font/ttf"
            crossorigin
        />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
    </head>
    <body class="font-sans antialiased">
        <Navbar />
        <slot />

        <script>
            import Lenis from "lenis";
            import { gsap } from "gsap";
            import { ScrollTrigger } from "gsap/ScrollTrigger";

            gsap.registerPlugin(ScrollTrigger);

            const lenis = new Lenis({ lerp: 0.2 });
            (window as any).lenis = lenis;

            lenis.on("scroll", ScrollTrigger.update);

            gsap.ticker.add((time) => {
                lenis.raf(time * 1000);
            });
            gsap.ticker.lagSmoothing(0);
        </script>

        <script>
            import { gsap } from "gsap";

            const links =
                document.querySelectorAll<HTMLElement>("[data-nav-link]");

            links.forEach((link) => {
                const hl = link.querySelector<HTMLElement>("[data-nav-hl]");
                const text = link.querySelector<HTMLElement>("span.relative");
                if (!hl) return;

                gsap.set(hl, { scaleY: 0, transformOrigin: "center top" });

                link.addEventListener("mouseenter", () => {
                    if (link.hasAttribute("data-nav-header")) {
                        link.classList.remove("opacity-70");
                    }
                    gsap.to(hl, {
                        scaleY: 1,
                        transformOrigin: "center top",
                        duration: 0.25,
                        ease: "power3.out",
                        overwrite: true,
                    });
                });

                link.addEventListener("mouseleave", () => {
                    if (link.hasAttribute("data-nav-header")) {
                        link.classList.add("opacity-70");
                    }
                    gsap.to(hl, {
                        scaleY: 0,
                        transformOrigin: "center bottom",
                        duration: 0.05,
                        delay: 0,
                        ease: "power3.out",
                        overwrite: true,
                    });
                });
            });
        </script>
    </body>
</html>
