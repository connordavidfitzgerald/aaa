<script>
    const nav = document.querySelector<HTMLElement>("[data-navbar]");
    const root = document.documentElement;
    const SCROLL_RANGE = 800;
    let ticking = false;

    function updateShrink() {
        const progress = Math.min(
            1,
            Math.max(0, window.scrollY / SCROLL_RANGE),
        );
        root.style.setProperty("--nav-shrink", progress.toString());
        ticking = false;
    }

    function onScroll() {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(updateShrink);
    }

    function updateHeight() {
        if (!nav) return;
        root.style.setProperty(
            "--nav-height",
            `${nav.getBoundingClientRect().height}px`,
        );
    }

    if (nav) {
        updateShrink();
        updateHeight();
        window.addEventListener("scroll", onScroll, { passive: true });
        const ro = new ResizeObserver(updateHeight);
        ro.observe(nav);
    }
</script>
