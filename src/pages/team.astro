---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import team from "../assets/images/team.jpg";
import jj from "../assets/images/jj.jpg";
import luckensy from "../assets/images/luckensy.jpg";
import jordane from "../assets/images/jordane.jpg";
import johnelle from "../assets/images/johnelle.jpg";
import reatchy from "../assets/images/reatchy.jpg";
import { projects } from "../data/projects";

const projectsForMember = (name: string) =>
    projects.filter((p) => p.team.includes(name)).map((p) => p.client);

const core = [
    {
        key: "jj",
        slug: "jean-julien",
        name: "Jean-Julien Hazoumé",
        role: "Co-Founder, Designer",
        location: "Montréal, QC",
    },
    {
        key: "luckensy",
        slug: "luckensy",
        name: "Luckensy Odigé",
        role: "Co-Founder, Designer",
        location: "Montréal, QC",
    },
    {
        key: "jordane",
        slug: "jordane",
        name: "Jordane Kaluma",
        role: "Co-Founder, Copywriter",
        location: "Montréal, QC",
    },
    {
        key: "johnelle",
        slug: "johnelle",
        name: "Johnelle Smith",
        role: "Co-Founder, Designer",
        location: "Montréal, QC",
    },
    {
        key: "reatchy",
        slug: "reatchy",
        name: "Reatchy Legros",
        role: "Co-Founder, Photographer",
        location: "Montréal, QC",
    },
];

const collaborators = core;

const memberImages = [
    { key: "jj", src: jj, alt: "Jean-Julien Hazoumé" },
    { key: "luckensy", src: luckensy, alt: "Luckensy Odigé" },
    { key: "jordane", src: jordane, alt: "Jordane Kaluma" },
    { key: "johnelle", src: johnelle, alt: "Johnelle Smith" },
    { key: "reatchy", src: reatchy, alt: "Reatchy Legros" },
];

const sections = [
    { label: "Core", members: core },
    { label: "Collaborators", members: collaborators },
];
---

<Layout title="Applied Archive Atelier">
    <main class="flex flex-col px-2 text-xs leading-[120%] md:min-h-screen">
        <div
            class="flex md:flex-1 items-center pt-[calc(var(--nav-height)*1.2)] md:pt-[var(--nav-height)] md:pb-6"
        >
            <div class="grid grid-cols-18 gap-2 w-full">
                <div
                    class="col-span-12 col-start-4 md:col-start-7 md:col-span-6 aspect-square relative"
                >
                    <Image
                        src={team}
                        alt="team"
                        class="absolute inset-0 w-full h-full object-cover block"
                        data-team-image="default"
                    />
                    {
                        memberImages.map((img) => (
                            <Image
                                src={img.src}
                                alt={img.alt}
                                data-team-image={img.key}
                                class="hidden md:block absolute inset-0 w-full h-full object-cover opacity-0"
                            />
                        ))
                    }
                </div>
            </div>
        </div>
        <div class="flex flex-col gap-0 md:pt-0 pb-4">
            {
                sections.map((section) => (
                    <div class="border-t border-black/20 pt-2 pb-2">
                        {section.members.map((member, i) => {
                            const memberProjects = projectsForMember(
                                member.name,
                            );
                            return (
                                <a
                                    href={`/team/${member.slug}`}
                                    data-team-row
                                    data-member={member.key}
                                    class="grid grid-cols-12 md:grid-cols-18 gap-x-2 relative"
                                >
                                    <span
                                        data-team-hl
                                        class="absolute inset-0 bg-green scale-y-0 origin-top hidden md:block"
                                    />
                                    <p class="col-span-12 md:col-span-2 relative z-10 opacity-70">
                                        {i === 0 ? section.label : ""}
                                    </p>
                                    <p class="col-span-12 md:col-span-4 relative z-10">
                                        {member.name}
                                    </p>
                                    <p class="col-span-6 md:col-span-4 relative z-10 opacity-70 md:opacity-100">
                                        {member.role}
                                    </p>
                                    <p class="col-span-6 md:col-span-4 relative z-10 opacity-70 md:opacity-100 text-right md:text-left">
                                        {member.location}
                                    </p>
                                    <p class="col-span-12 md:col-span-4 relative z-10 flex justify-between gap-2">
                                        <span>{memberProjects.join(", ")}</span>
                                        <span>[+]</span>
                                    </p>
                                </a>
                            );
                        })}
                    </div>
                ))
            }
        </div>
    </main>

    <script>
        import { gsap } from "gsap";

        const canHover = window.matchMedia("(hover: hover)").matches;

        const rows = document.querySelectorAll<HTMLElement>("[data-team-row]");
        const memberImages = document.querySelectorAll<HTMLElement>(
            '[data-team-image]:not([data-team-image="default"])',
        );

        const highlights =
            document.querySelectorAll<HTMLElement>("[data-team-hl]");

        function resetAll() {
            highlights.forEach((hl) => {
                gsap.set(hl, { scaleY: 0, transformOrigin: "center top" });
            });
            memberImages.forEach((img) => {
                gsap.set(img, { opacity: 0 });
            });
        }

        window.addEventListener("pageshow", () => resetAll());
        window.addEventListener("pagehide", () => resetAll());

        if (canHover) {
            rows.forEach((row) => {
                const hl = row.querySelector<HTMLElement>("[data-team-hl]");
                const member = row.dataset.member;
                if (!hl) return;

                gsap.set(hl, { scaleY: 0, transformOrigin: "center top" });

                row.addEventListener("mouseenter", () => {
                    gsap.to(hl, {
                        scaleY: 1,
                        transformOrigin: "center top",
                        duration: 0.25,
                        ease: "power3.out",
                        overwrite: true,
                    });
                    memberImages.forEach((img) => {
                        gsap.set(img, {
                            opacity: img.dataset.teamImage === member ? 1 : 0,
                        });
                    });
                });

                row.addEventListener("mouseleave", () => {
                    gsap.to(hl, {
                        scaleY: 0,
                        transformOrigin: "center bottom",
                        duration: 0.05,
                        ease: "power3.out",
                        overwrite: true,
                    });
                    memberImages.forEach((img) => {
                        gsap.set(img, { opacity: 0 });
                    });
                });

                row.addEventListener("click", () => {
                    gsap.set(hl, { scaleY: 0, transformOrigin: "center top" });
                    memberImages.forEach((img) => {
                        gsap.set(img, { opacity: 0 });
                    });
                });
            });
        }
    </script>
</Layout>
