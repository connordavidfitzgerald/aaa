---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import { projects } from "../../data/projects";
import jj from "../../assets/images/jj.jpg";
import luckensy from "../../assets/images/luckensy.jpg";
import jordane from "../../assets/images/jordane.jpg";
import johnelle from "../../assets/images/johnelle.jpg";
import reatchy from "../../assets/images/reatchy.jpg";

export function getStaticPaths() {
    const projectIds = ["chimie", "bxb", "ecozoic", "ctrl", "ellipse"];
    return [
        {
            params: { member: "jean-julien" },
            props: {
                name: "Jean-Julien Hazoumé",
                role: "Co-Founder, Designer",
                image: jj,
                bio: "Jean-Julien Hazoumé, creative direction, design & development. Propels each mission toward the form that amplifies it – from a no-code site to an object",
                instagram: "https://instagram.com",
                linkedin: "https://linkedin.com",
                projectIds: ["chimie", "ecozoic"],
            },
        },
        {
            params: { member: "luckensy" },
            props: {
                name: "Luckensy Odigé",
                role: "Co-Founder, Designer",
                image: luckensy,
                bio: "Luckensy Odigé, graphic design, illustration, photography. Watches over the identity of a mission – poster, report, campaign, image – so it stays legible from one culture to the next.",
                instagram: "https://instagram.com",
                linkedin: "https://linkedin.com",
                projectIds: ["ellipse"],
            },
        },
        {
            params: { member: "jordane" },
            props: {
                name: "Jordane Kaluma",
                role: "Co-Founder, Copywriter",
                image: jordane,
                bio: "Jordane Kaluma, semiotics, creative strategy, funding. Reads the cultural signals beneath a project and turns them into positioning, language, and the funding that keeps a mission alive.",
                instagram: "https://instagram.com",
                linkedin: "https://linkedin.com",
                projectIds: [""],
            },
        },
        {
            params: { member: "johnelle" },
            props: {
                name: "Johnelle Smith",
                role: "Co-Founder, Designer",
                image: johnelle,
                bio: "Johnelle Smith, graphic and experiential design. Treats design as cultural infrastructure – identities and spaces that make room for the artists, organizers, and institutions shaping cultural life.",
                instagram: "https://instagram.com",
                linkedin: "https://linkedin.com",
                projectIds: ["bxb", "ctrl"],
            },
        },
        {
            params: { member: "reatchy" },
            props: {
                name: "Reatchy Legros",
                role: "Co-Founder, Photographer",
                image: reatchy,
                bio: "Reatchy Legros, direction and video. Directs and edits films that carry a point of view, from shoot to final cut – to mirror, question, and enchant the real.",
                instagram: "https://instagram.com",
                linkedin: "https://linkedin.com",
                projectIds: [""],
            },
        },
    ];
}

const { name, role, image, bio, instagram, linkedin, projectIds } = Astro.props;

const memberProjects = projectIds
    .map((id: string) => projects.find((p) => p.id === id))
    .filter((p): p is (typeof projects)[number] => Boolean(p));
---

<Layout title={`${name} — Applied Archive Atelier`}>
    <main
        class="flex flex-col justify-start px-2 w-full h-fit text-xs leading-[115%]"
    >
        <div
            class="pt-[calc(var(--nav-height)*1.2)] grid grid-cols-1 md:grid-cols-18 gap-2 w-full items-stretch md:items-start mb-2 pb-2 md:pb-0"
        >
            <div
                class="md:col-span-8 flex flex-col justify-between gap-2 md:gap-0 min-h-[calc(100svh-var(--nav-height)*1.2-1rem)] md:min-h-0 md:h-[calc(100svh-var(--nav-height)*1.2-1rem)] md:sticky md:top-[calc(var(--nav-height)*1.2)] md:self-start"
            >
                <div class="w-full flex flex-col justify-start">
                    <a
                        href="/team"
                        data-nav-link
                        class="relative w-fit py-2 md:py-0 mb-4 flex items-center"
                    >
                        <span
                            data-nav-hl
                            class="absolute inset-0 bg-green scale-y-0 origin-top"
                        ></span>
                        <span class="relative z-10">← BACK</span>
                    </a>
                    <div
                        class="grid grid-cols-8 gap-x-2 gap-y-6 md:gap-y-4 pb-2 md:pb-8"
                    >
                        <div
                            class="col-span-5 row-start-1 h-full flex flex-col justify-between md:hidden"
                        >
                            <div class="flex flex-col gap-2">
                                <div>
                                    <p>{name}</p>
                                    <p class="opacity-70">{role}</p>
                                </div>
                                <p>{bio}</p>
                            </div>
                            <div class="grid grid-cols-4 gap-x-2">
                                <a
                                    href={instagram}
                                    class="col-span-2"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    Instagram <span class="text-[10px]">↗</span>
                                </a>
                                <a
                                    href={linkedin}
                                    class="col-span-2"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    LinkedIn <span class="text-[10px]">↗</span>
                                </a>
                            </div>
                        </div>
                        <div
                            class="col-span-3 row-start-1 md:row-start-2 aspect-square"
                        >
                            <Image
                                src={image}
                                alt={name}
                                class="w-full h-full object-cover block"
                            />
                        </div>

                        <div
                            class="hidden md:block md:col-start-1 md:col-span-3 md:row-start-1"
                        >
                            <p>{name}</p>
                            <p class="opacity-70">{role}</p>
                        </div>
                        <div
                            class="hidden md:grid md:col-start-5 md:col-span-4 md:row-start-1 md:row-span-2 grid-cols-4 gap-x-2 gap-y-4 h-fit"
                        >
                            <p class="col-span-3 pb-8">{bio}</p>
                            <a
                                href={instagram}
                                class="col-span-2"
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                Instagram <span class="text-[10px]">↗</span>
                            </a>
                            <a
                                href={linkedin}
                                class="col-span-2"
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                LinkedIn <span class="text-[10px]">↗</span>
                            </a>
                        </div>
                    </div>
                    <div class="flex md:hidden opacity-70 pt-10 pb-1">
                        Selected Projects
                    </div>
                    <div class="md:hidden flex flex-col gap-2 md:pb-4">
                        {
                            memberProjects.map((project) => (
                                <a
                                    href={`/projects/${project.id}`}
                                    class="block w-full"
                                >
                                    {project.image ? (
                                        <Image
                                            src={project.image}
                                            alt={project.client}
                                            class="w-full h-auto block"
                                        />
                                    ) : project.thumbnail ? (
                                        <img
                                            src={project.thumbnail}
                                            alt={project.client}
                                            class="w-full h-auto block"
                                        />
                                    ) : null}
                                </a>
                            ))
                        }
                    </div>
                </div>
                <div class="w-full flex flex-col justify-end">
                    <div class="grid grid-cols-8 h-fit">
                        <p class="col-span-8 md:col-span-6 w-full">
                            Though our team is small by design, we're always
                            open to building relationships with standout
                            creatives whose values strongly align with ours. If
                            our approach resonates with you, we'd love to hear
                            from you at jobs@appliedarchive.com.
                        </p>
                    </div>
                </div>
            </div>
            <div
                class="hidden md:flex md:col-span-10 flex-col gap-2 self-start"
            >
                {
                    memberProjects.map((project) => (
                        <a
                            href={`/projects/${project.id}`}
                            class="block w-full"
                        >
                            {project.image ? (
                                <Image
                                    src={project.image}
                                    alt={project.client}
                                    class="w-full h-auto block"
                                />
                            ) : project.thumbnail ? (
                                <img
                                    src={project.thumbnail}
                                    alt={project.client}
                                    class="w-full h-auto block"
                                />
                            ) : null}
                        </a>
                    ))
                }
            </div>
        </div>
    </main>
</Layout>
