---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Applied Archive Atelier — Initiatives">
    <main
        class="flex flex-col justify-start px-2 w-full text-xs leading-[115%] md:h-screen pt-[calc(var(--nav-height)*1.2)] pb-2"
    >
        <div class="grid grid-cols-18 gap-2 flex-1 min-h-0">
            <aside
                class="md:col-span-4 col-span-8 self-start flex flex-col gap-2 pb-12 md:pb-0"
            >
                <h1 class="uppercase">Initiatives</h1>

                <p>
                    Some projects exist because they need to, not because anyone
                    paid for them. We carry these alongside the studio — in
                    service of the people they're built for.
                </p>
            </aside>

            <div
                class="col-span-10 md:col-span-14 grid grid-cols-14 gap-x-2 gap-y-[var(--nav-gap)] h-fit"
            >
                <div class="col-span-4 h-1 md:flex hidden"></div>
                <article
                    class="flex flex-col col-span-12 md:col-span-4 justify-start gap-8"
                >
                    <div class="flex flex-col">
                        <h2 class="uppercase">Gia</h2>
                        <p class="opacity-70">Grants, written and indexed</p>
                        <p class="pt-2">
                            A grant writing tool and a searchable index — built
                            to help people find the funding they need and ask
                            for it well.
                        </p>
                    </div>
                    <a
                        href="https://www.instagram.com/gia.grants/"
                        data-nav-link
                        class="relative flex items-center w-fit"
                    >
                        <span
                            data-nav-hl
                            class="absolute inset-0 bg-green scale-y-0 origin-top"
                        ></span>
                        <span class="relative z-10">
                            Visit <span class="text-[10px]">↗</span>
                        </span>
                    </a>
                </article>

                <article
                    class="flex flex-col justify-start col-span-12 md:col-span-4 gap-8"
                >
                    <div class="flex flex-col">
                        <h2 class="uppercase">DJTAL</h2>
                        <p class="opacity-70">An affordable DJ studio</p>
                        <p class="pt-2">
                            A place to practice and learn — turntables, open
                            hours, and mentorship, at a price that doesn't gate
                            the craft.
                        </p>
                    </div>
                    <a
                        href="https://djt.al"
                        data-nav-link
                        class="relative flex items-center w-fit"
                    >
                        <span
                            data-nav-hl
                            class="absolute inset-0 bg-green scale-y-0 origin-top"
                        ></span>
                        <span class="relative z-10">
                            Visit <span class="text-[10px]">↗</span>
                        </span>
                    </a>
                </article>

                <article
                    class="md:col-start-5 col-span-12 md:col-span-4 flex flex-col justify-start gap-8"
                >
                    <div class="flex flex-col">
                        <h2 class="uppercase">Espace Septima</h2>
                        <p class="opacity-70">
                            Community space & studio office
                        </p>
                        <p class="pt-2">
                            Applied Archive's home base — and a room held open
                            for non-profits and emerging creatives who need a
                            place to work, meet, and build.
                        </p>
                    </div>
                    <p class="opacity-70">Montréal, QC</p>
                </article>
            </div>
        </div>
    </main>
</Layout>
