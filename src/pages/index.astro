---
import Layout from "../layouts/Layout.astro";

import { Image } from "astro:assets";
import { MuxPlayer } from "@mux/mux-player-astro";

import { projects } from "../data/projects";
---

<Layout title="Applied Archive Atelier">
    <main class="flex flex-col justify-start px-2 pb-8">
        <section
            id="video"
            class="h-fit pt-[var(--nav-height)] flex flex-col justify-center items-center"
        >
            <MuxPlayer
                playbackId="iU8heoPsVZrdSsS9D006daozDYoI01D7pHFNoSSSuDkuc"
                autoplay
                muted
                minResolution="1080p"
                loop
            />
        </section>
        <section
            id="tagline"
            class="w-full aspect-video flex flex-col justify-center items-center"
        >
            <h3 class="text-md bg-green leading-[120%] px-1 pt-0.5">
                Some work is worth doing together.
            </h3>
        </section>
        <section
            id="projects"
            class="flex flex-col w-full gap-25 scroll-mt-[calc(var(--nav-height)*1.2)]"
        >
            <div class="flex flex-col gap-25">
                {
                    projects.map((project) => {
                        const flatMedia = project.media.flatMap((row) =>
                            Array.isArray(row) ? row : [row],
                        );
                        const heroMedia = flatMedia.slice(0, 2);
                        const colSpans = ["md:col-span-8", "md:col-span-5"];

                        return (
                            <a
                                href={`/projects/${project.id}`}
                                id={project.id}
                                data-project
                                class="grid grid-cols-18 gap-2 text-xs"
                            >
                                <div class="grid grid-cols-18 gap-2 col-span-18 sticky top-[calc(var(--nav-height)-0.5em)] h-fit pb-1 z-40 bg-white leading-[105%]">
                                    <div class="col-span-8 grid-cols-9 grid mt-4">
                                        <div class="col-span-6 text-[0.8rem] leading-[110%]">
                                            <div class="">{project.client}</div>
                                            <div class="pt-[1em]">
                                                {project.description}
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-span-4 mt-4 flex flex-col gap-2">
                                        <p class="opacity-70">Services</p>
                                        {project.services}
                                    </div>
                                    <div class="col-span-4 mt-4 flex flex-col gap-2">
                                        <p class="opacity-70">Team</p>
                                        {project.team}
                                    </div>
                                    <div class="col-span-2 mt-4 flex flex-col gap-2">
                                        <p class="opacity-70">Date</p>
                                        {project.date}
                                    </div>
                                </div>
                                {heroMedia.map((item, i) => (
                                    <div class={`col-span-18 ${colSpans[i]}`}>
                                        <div class="relative w-full h-fit overflow-hidden flex items-start justify-start group">
                                            {item.kind === "video" ? (
                                                <div class="relative w-full h-fit group-hover:mix-blend-multiply">
                                                    <img
                                                        src={
                                                            item.thumbnail ??
                                                            `https://image.mux.com/${item.muxPlaybackId}/thumbnail.jpg`
                                                        }
                                                        alt=""
                                                        class="w-full h-auto md:h-full md:object-cover block"
                                                    />
                                                    <MuxPlayer
                                                        playback-id={
                                                            item.muxPlaybackId
                                                        }
                                                        class="absolute inset-0 w-full h-auto"
                                                        style="--media-background-color: white;"
                                                        loop
                                                        muted
                                                        max-resolution="2160p"
                                                        min-resolution="1080p"
                                                        preload="auto"
                                                    />
                                                    <div class="absolute inset-0 z-10" />
                                                </div>
                                            ) : (
                                                <Image
                                                    src={item.src}
                                                    alt={item.alt ?? ""}
                                                    class="w-full h-auto  group-hover:mix-blend-multiply ease-in transition duration-500"
                                                />
                                            )}
                                            <div class="absolute inset-0 z-20 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none">
                                                <span class="text-xs  bg-green px-1 pt-0.5">
                                                    View Project
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                ))}
                            </a>
                        );
                    })
                }
            </div>
        </section>
    </main>

    <script>
        customElements.whenDefined("mux-player").then(() => {
            const observer = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        const player = entry.target as HTMLElement & {
                            play(): Promise<void>;
                            pause(): void;
                        };
                        if (entry.isIntersecting) {
                            player.play().catch(() => {});
                        } else {
                            player.pause();
                        }
                    });
                },
                { threshold: 0.5 },
            );

            document.querySelectorAll("mux-player").forEach((player) => {
                observer.observe(player);
            });
        });
    </script>
</Layout>
